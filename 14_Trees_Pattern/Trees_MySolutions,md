class Solution {
    public List<Integer> inorderTraversal(TreeNode root) {
        List<Integer> ans = new ArrayList<>();
        TreeNode node = root;
        Deque<TreeNode> st = new ArrayDeque<>();

        while(true){
            if(node!=null){
                st.push(node);
                node = node.left ;
            }else{
                if(st.isEmpty()) break;
                node = st.pop();
                ans.add(node.val);
                node = node.right;
            }
        }
        return ans;
        
    }
}


class Solution {
    public List<Integer> inorderTraversal(TreeNode root) {
        List<Integer> ans = new ArrayList<>();
        TreeNode node = root;
        Deque<TreeNode> st = new ArrayDeque<>();

        while(node!=null || !st.isEmpty()){
            while(node!=null){
                st.push(node);
                node = node.left;
            }
            node = st.pop();
            ans.add(node.val);
            node = node.right;
        }
        return ans;
        
    }
}
