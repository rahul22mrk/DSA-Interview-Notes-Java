2. 144. Binary Tree Preorder Traversal


class Solution {
    public List<Integer> preorderTraversal(TreeNode root) {
        List<Integer> ans = new ArrayList<>();
        TreeNode node = root;
        solve(node,ans);
        return ans;
        
    }

    private void solve(TreeNode node, List<Integer>ans){
        if(node==null){
            return ;
        }

        ans.add(node.val);
        solve(node.left,ans);
        solve(node.right,ans);
    }
}

class Solution {
    public List<Integer> preorderTraversal(TreeNode root) {
        List<Integer> ans = new ArrayList<>();
        Deque<TreeNode> st = new ArrayDeque<>();
        if(root==null) return ans;

        TreeNode node = root;
        st.push(node);

        while(!st.isEmpty()){
            node = st.pop();
            ans.add(node.val);

            if(node.right!=null){
                st.push(node.right);
            }

            if(node.left!=null){
                st.push(node.left);
            }
        }
        return ans;
    }
}


